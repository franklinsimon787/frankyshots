  },
  "dependencies": {
    "@frankyshots/db": "*",
    "@frankyshots/shared": "*",
    "@vinext/cloudflare": "^1.0.0-beta.6",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.10",
    "next": "14.2.15",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "vinext": "^1.0.0-beta.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.3",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "^26.4.1",
    "@types/react": "18.3.2",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.15",
