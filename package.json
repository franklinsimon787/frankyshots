{
  "name": "frankyshots-production",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "dev:web": "npm run dev --workspace apps/web",
    "dev:admin": "npm run dev --workspace apps/admin",
    "build:web": "npm run build --workspace apps/web",
    "build:admin": "npm run build --workspace apps/admin",
    "db:generate": "npm run db:generate --workspace packages/db",
    "db:push": "npm run db:push --workspace packages/db",
    "db:seed": "npm run db:seed --workspace packages/db"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "6.19.3",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "jose": "^6.2.9",
    "prisma": "6.19.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "better-sqlite3@12.11.1": true,
    "better-sqlite3@13.0.3": true,
    "esbuild@0.23.1": true
  }
}
